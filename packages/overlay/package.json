{
  "name": "@specula/overlay",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Specula browser overlay — selection, hit-testing, intent emission.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "esbuild src/index.ts --bundle --format=iife --global-name=SpeculaOverlay --target=es2022 --outfile=dist/overlay.js",
    "browser-verify": "npm run build && node browser-verify.mjs",
    "browser-verify-dev": "npm run build && node browser-verify-dev.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^21.0.0",
    "@types/node": "^25.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.49.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  }
}
